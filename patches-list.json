      "use": true,
      "dependencies": [
        "BytecodePatch",
        "HushThreads settings"
      ],
      "compatiblePackages": {
        "com.instagram.barcelona": [
          "450.0.0.51.78",
          "449.0.0.54.82",
          "448.0.0.54.85"
        ]
      },
