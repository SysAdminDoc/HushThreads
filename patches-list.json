  "appNames": {
    "com.instagram.barcelona": "Threads"
  },
  "patches": [
    {
      "name": "Block background-return feed refresh",
      "description": "Keeps your place in the feed when you come back to Threads within ten minutes, or after any time away with No time limit on. Pull to refresh and a fresh launch still load new posts. Its switch, Keep feed position on return, is on the Feed page of HushThreads settings and starts off.",
